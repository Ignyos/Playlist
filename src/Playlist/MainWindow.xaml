<Window x:Class="Playlist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Playlist"
        mc:Ignorable="d"
        Title="Playlist" Height="600" Width="900" MinHeight="400" MinWidth="600"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="{DynamicResource Brush.Neutral.Background}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Using Ignyos design system theme -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Ignyos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="Border" Padding="8" SnapsToDevicePixels="True" CornerRadius="{DynamicResource Radius.MD}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush.Accent.Primary}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush.Neutral.Surface.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Neutral.Text}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Progress Indicator Pill -->
        <Style x:Key="ProgressIndicatorPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Pill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Neutral.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProgressPercentage}" Value="100">
                    <Setter Property="Background" Value="{DynamicResource Brush.Semantic.Success}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Style="{StaticResource Menu.Base}">
            <MenuItem Header="_File" Style="{StaticResource MenuItem.Base}">
                <MenuItem Header="_New Playlist" Click="NewPlaylist_Click" Style="{StaticResource MenuItem.Base}"/>
                <MenuItem Header="_History" Click="History_Click" Style="{StaticResource MenuItem.Base}"/>
                <MenuItem Header="_Settings" Click="Settings_Click" Style="{StaticResource MenuItem.Base}"/>
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" Style="{StaticResource MenuItem.Base}"/>
            </MenuItem>
            <MenuItem Header="_About" Style="{StaticResource MenuItem.Base}">
                <MenuItem Header="_Playlist" Click="AboutPlaylist_Click" Style="{StaticResource MenuItem.Base}"/>
                <MenuItem Header="_Ignyos" Click="AboutIgnyos_Click" Style="{StaticResource MenuItem.Base}"/>
                <Separator />
                <MenuItem Header="_Check for Updates" Click="CheckForUpdates_Click" Style="{StaticResource MenuItem.Base}"/>
            </MenuItem>
        </Menu>

        <!-- Main Content Area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="150" />
                <!-- <ColumnDefinition Width="5" /> -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Playlists -->
            <Border Grid.Column="0">
                <DockPanel>
                    <!-- Search and Sort Controls -->
                    <DockPanel DockPanel.Dock="Top" Margin="10">
                        <Button Name="SortMenuButton" DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,5,0" Content="☰" Click="SortMenu_Click" Style="{StaticResource Button.Secondary}" Padding="0">
                            <Button.ContextMenu>
                                <ContextMenu Name="SortContextMenu">
                                    <MenuItem Header="Sort by create date">
                                        <MenuItem Header="Newest first" Click="SortByCreatedDesc_Click" />
                                        <MenuItem Header="Oldest first" Click="SortByCreatedAsc_Click" />
                                    </MenuItem>
                                    <MenuItem Header="Sort by last played">
                                        <MenuItem Header="Most recent first" Click="SortByPlayedDesc_Click" />
                                        <MenuItem Header="Longest ago first" Click="SortByPlayedAsc_Click" />
                                    </MenuItem>
                                    <MenuItem Header="Sort by name">
                                        <MenuItem Header="A - Z" Click="SortByNameAsc_Click" />
                                        <MenuItem Header="Z - A" Click="SortByNameDesc_Click" />
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBox Name="SearchTextBox" Height="30" VerticalContentAlignment="Center" Background="{DynamicResource Brush.Neutral.Background}" BorderBrush="{DynamicResource Brush.Neutral.Border}" Foreground="{DynamicResource Brush.Neutral.Text}" Padding="8" />
                    </DockPanel>

                    <!-- Playlists List -->
                    <ListBox Name="PlaylistsListBox" Margin="10,0,10,10" Background="{DynamicResource Brush.Neutral.Background}" BorderBrush="{DynamicResource Brush.Neutral.Border}"
                             DisplayMemberPath="DisplayText"
                             AllowDrop="True" 
                             PreviewMouseLeftButtonDown="Playlist_PreviewMouseLeftButtonDown"
                             MouseMove="Playlist_MouseMove"
                             DragOver="Playlist_DragOver"
                             Drop="Playlist_Drop">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit" Click="EditPlaylist_Click" />
                                <MenuItem Header="Remove" Click="RemovePlaylist_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- GridSplitter -->
            <!-- <GridSplitter Grid.Column="1" Width="0" HorizontalAlignment="Stretch" /> -->

            <!-- Main Panel - Playlist Items -->
            <DockPanel Grid.Column="1">
                <!-- Column Headers -->
                <Grid DockPanel.Dock="Top" Margin="10,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Progress" FontWeight="SemiBold" Margin="5,0,10,0" Width="50" Foreground="{DynamicResource Brush.Neutral.Text}"/>
                    <TextBlock Grid.Column="1" Text="Title" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Neutral.Text}"/>
                </Grid>

                <!-- Playlist Items List -->
                <ListBox Name="PlaylistItemsListBox" Margin="10,0,10,10" Background="{DynamicResource Brush.Neutral.Background}" BorderBrush="{DynamicResource Brush.Neutral.Border}"
                         MouseDoubleClick="PlaylistItem_DoubleClick"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="PlaylistItem_PreviewMouseLeftButtonDown"
                         MouseMove="PlaylistItem_MouseMove"
                         DragOver="PlaylistItem_DragOver"
                         Drop="PlaylistItem_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Progress Indicator Pill -->
                                <Border Grid.Column="0" Width="50" Height="20" CornerRadius="10" 
                                        Margin="0,0,10,0"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Neutral.Border}"
                                        Style="{StaticResource ProgressIndicatorPillStyle}">
                                    <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0}%}" 
                                               FontSize="14" 
                                           Foreground="{DynamicResource Brush.Neutral.Text}"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                                <!-- File Name -->
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Play From Beginning" Click="PlayItem_Click" />
                            <MenuItem Header="Continue" Click="ContinueItem_Click" />
                            <Separator />
                            <MenuItem Header="Rename" Click="RenameItem_Click" />
                            <MenuItem Header="Remove" Click="RemoveItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
