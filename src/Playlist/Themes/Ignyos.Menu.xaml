<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      Ignyos Design System - Menu Component Styles
      Requires: Ignyos.Colors.xaml, Ignyos.Tokens.xaml
      
      Design: Pill-style menu items based on the Ignyos design system
      - Default: subtle surface background with neutral border
      - Hover: slightly lighter surface, accent orange border, accent text (0.2s transition)
      - Pressed: active surface with accent border and text
    - Submenu Open: same as hover state
    -->

    <!-- ========================================================= -->
    <!-- Menu Bar Style                                            -->
    <!-- ========================================================= -->
    <Style x:Key="Menu.Base" TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Brush.Neutral.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Neutral.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <!-- ========================================================= -->
    <!-- Menu Item Style - Pill Style with Animated Transitions     -->
    <!-- ========================================================= -->
    <Style x:Key="MenuItem.Base" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Neutral.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Padding" Value="12,6,12,6"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="border"
                            Background="{DynamicResource Brush.Neutral.Surface}"
                            BorderBrush="{DynamicResource Brush.Neutral.Border}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource Radius.MD}">
                        <Grid>
                            <ContentPresenter ContentSource="Header"
                                            RecognizesAccessKey="True"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=border}"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Brush.Neutral.Surface}"
                                        BorderBrush="{DynamicResource Brush.Neutral.Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Effect="{DynamicResource Shadow.LG}"
                                        Padding="4">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    SnapsToDevicePixels="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover state: only when mouse is over and NOT pressed -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsPressed" Value="False"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Animate background to light blue hover -->
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                       Storyboard.TargetProperty="Background.Color" 
                                                       To="#1a1a1a" 
                                                       Duration="0:0:0.2"/>
                                        <!-- Animate border to soft blue -->
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                       Storyboard.TargetProperty="BorderBrush.Color" 
                                                       To="#c18b5a" 
                                                       Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Animate back to default transparent -->
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                       Storyboard.TargetProperty="Background.Color" 
                                                       To="#0f0f0f" 
                                                       Duration="0:0:0.2"/>
                                        <!-- Animate border back to neutral -->
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                       Storyboard.TargetProperty="BorderBrush.Color" 
                                                       To="#1a1a1a" 
                                                       Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/>
                        </MultiTrigger>
                        
                        <!-- Pressed state: maintains hover appearance while pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Neutral.Surface.Hover}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/>
                        </Trigger>
                        
                        <!-- Submenu open state: same as hover -->
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                       Storyboard.TargetProperty="Background.Color" 
                                                       To="#1a1a1a" 
                                                       Duration="0:0:0.2"/>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                       Storyboard.TargetProperty="BorderBrush.Color" 
                                                       To="#c18b5a" 
                                                       Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/>
                        </Trigger>
                        
                        <!-- Disabled state -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Neutral.Text.Muted}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Neutral.Text.Muted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
